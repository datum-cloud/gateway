{
  "admin": {
    "address": {
      "socket_address": {
        "address": "127.0.0.1",
        "port_value": 9901
      }
    }
  },
  "static_resources": {
    "listeners": [
      {
        "name": "forward_proxy",
        "address": {
          "socket_address": {
            "address": "0.0.0.0",
            "port_value": 3128
          }
        },
        "filter_chains": [
          {
            "filters": [
              {
                "name": "envoy.filters.network.http_connection_manager",
                "typed_config": {
                  "@type": "type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager",
                  "stat_prefix": "forward_proxy",
                  "codec_type": "HTTP1",
                  "http_protocol_options": {
                    "allow_absolute_url": true
                  },
                  "stream_idle_timeout": "300s",
                  "upgrade_configs": [
                    {
                      "upgrade_type": "CONNECT"
                    }
                  ],
                  "route_config": {
                    "name": "authenticated_profiles",
                    "request_headers_to_remove": [
                      "proxy-authorization",
                      "proxy-connection",
                      "x-datum-egress-profile",
                      "x-datum-upstream-cluster"
                    ],
                    "virtual_hosts": [
                      {
                        "name": "destinations",
                        "domains": [
                          "*"
                        ],
                        "routes": [
                          {
                            "match": {
                              "connect_matcher": {},
                              "dynamic_metadata": [
                                {
                                  "filter": "datum.auth",
                                  "path": [
                                    {
                                      "key": "profile"
                                    }
                                  ],
                                  "value": {
                                    "string_match": {
                                      "exact": "exit-a"
                                    }
                                  }
                                }
                              ]
                            },
                            "route": {
                              "cluster": "exit-a",
                              "timeout": "0s",
                              "retry_policy": {
                                "num_retries": 0
                              },
                              "upgrade_configs": [
                                {
                                  "upgrade_type": "CONNECT",
                                  "connect_config": {}
                                }
                              ]
                            }
                          },
                          {
                            "match": {
                              "prefix": "/",
                              "dynamic_metadata": [
                                {
                                  "filter": "datum.auth",
                                  "path": [
                                    {
                                      "key": "profile"
                                    }
                                  ],
                                  "value": {
                                    "string_match": {
                                      "exact": "exit-a"
                                    }
                                  }
                                }
                              ]
                            },
                            "route": {
                              "cluster": "exit-a",
                              "timeout": "30s",
                              "retry_policy": {
                                "num_retries": 0
                              }
                            }
                          },
                          {
                            "match": {
                              "connect_matcher": {},
                              "dynamic_metadata": [
                                {
                                  "filter": "datum.auth",
                                  "path": [
                                    {
                                      "key": "profile"
                                    }
                                  ],
                                  "value": {
                                    "string_match": {
                                      "exact": "exit-b"
                                    }
                                  }
                                }
                              ]
                            },
                            "route": {
                              "cluster": "exit-b",
                              "timeout": "0s",
                              "retry_policy": {
                                "num_retries": 0
                              },
                              "upgrade_configs": [
                                {
                                  "upgrade_type": "CONNECT",
                                  "connect_config": {}
                                }
                              ]
                            }
                          },
                          {
                            "match": {
                              "prefix": "/",
                              "dynamic_metadata": [
                                {
                                  "filter": "datum.auth",
                                  "path": [
                                    {
                                      "key": "profile"
                                    }
                                  ],
                                  "value": {
                                    "string_match": {
                                      "exact": "exit-b"
                                    }
                                  }
                                }
                              ]
                            },
                            "route": {
                              "cluster": "exit-b",
                              "timeout": "30s",
                              "retry_policy": {
                                "num_retries": 0
                              }
                            }
                          },
                          {
                            "match": {
                              "connect_matcher": {}
                            },
                            "direct_response": {
                              "status": 403
                            }
                          },
                          {
                            "match": {
                              "prefix": "/"
                            },
                            "direct_response": {
                              "status": 403
                            }
                          }
                        ]
                      }
                    ]
                  },
                  "http_filters": [
                    {
                      "name": "envoy.filters.http.lua",
                      "typed_config": {
                        "@type": "type.googleapis.com/envoy.extensions.filters.http.lua.v3.Lua",
                        "default_source_code": {
                          "filename": "/etc/envoy/auth.lua"
                        }
                      }
                    },
                    {
                      "name": "envoy.filters.http.rbac",
                      "typed_config": {
                        "@type": "type.googleapis.com/envoy.extensions.filters.http.rbac.v3.RBAC",
                        "rules": {
                          "action": "ALLOW",
                          "policies": {
                            "exit-a": {
                              "permissions": [
                                {
                                  "sourced_metadata": {
                                    "metadata_matcher": {
                                      "filter": "datum.auth",
                                      "path": [
                                        {
                                          "key": "profile"
                                        }
                                      ],
                                      "value": {
                                        "string_match": {
                                          "exact": "exit-a"
                                        }
                                      }
                                    },
                                    "metadata_source": "DYNAMIC"
                                  }
                                }
                              ],
                              "principals": [
                                {
                                  "any": true
                                }
                              ]
                            },
                            "exit-b": {
                              "permissions": [
                                {
                                  "sourced_metadata": {
                                    "metadata_matcher": {
                                      "filter": "datum.auth",
                                      "path": [
                                        {
                                          "key": "profile"
                                        }
                                      ],
                                      "value": {
                                        "string_match": {
                                          "exact": "exit-b"
                                        }
                                      }
                                    },
                                    "metadata_source": "DYNAMIC"
                                  }
                                }
                              ],
                              "principals": [
                                {
                                  "any": true
                                }
                              ]
                            }
                          }
                        }
                      }
                    },
                    {
                      "name": "envoy.filters.http.dynamic_forward_proxy",
                      "typed_config": {
                        "@type": "type.googleapis.com/envoy.extensions.filters.http.dynamic_forward_proxy.v3.FilterConfig",
                        "dns_cache_config": {
                          "name": "forward_proxy_dns",
                          "dns_lookup_family": "V4_ONLY",
                          "max_hosts": 1024,
                          "dns_cache_circuit_breaker": {
                            "max_pending_requests": 128
                          }
                        }
                      }
                    },
                    {
                      "name": "envoy.filters.http.router",
                      "typed_config": {
                        "@type": "type.googleapis.com/envoy.extensions.filters.http.router.v3.Router"
                      }
                    }
                  ]
                }
              }
            ]
          }
        ]
      }
    ],
    "clusters": [
      {
        "name": "exit-a",
        "connect_timeout": "5s",
        "lb_policy": "CLUSTER_PROVIDED",
        "cluster_type": {
          "name": "envoy.clusters.dynamic_forward_proxy",
          "typed_config": {
            "@type": "type.googleapis.com/envoy.extensions.clusters.dynamic_forward_proxy.v3.ClusterConfig",
            "dns_cache_config": {
              "name": "forward_proxy_dns",
              "dns_lookup_family": "V4_ONLY",
              "max_hosts": 1024,
              "dns_cache_circuit_breaker": {
                "max_pending_requests": 128
              }
            },
            "allow_coalesced_connections": false
          }
        },
        "upstream_bind_config": {
          "source_address": {
            "address": "198.18.0.11",
            "port_value": 0
          },
          "freebind": false
        },
        "circuit_breakers": {
          "thresholds": [
            {
              "max_retries": 0
            }
          ]
        }
      },
      {
        "name": "exit-b",
        "connect_timeout": "5s",
        "lb_policy": "CLUSTER_PROVIDED",
        "cluster_type": {
          "name": "envoy.clusters.dynamic_forward_proxy",
          "typed_config": {
            "@type": "type.googleapis.com/envoy.extensions.clusters.dynamic_forward_proxy.v3.ClusterConfig",
            "dns_cache_config": {
              "name": "forward_proxy_dns",
              "dns_lookup_family": "V4_ONLY",
              "max_hosts": 1024,
              "dns_cache_circuit_breaker": {
                "max_pending_requests": 128
              }
            },
            "allow_coalesced_connections": false
          }
        },
        "upstream_bind_config": {
          "source_address": {
            "address": "198.18.0.12",
            "port_value": 0
          },
          "freebind": false
        },
        "circuit_breakers": {
          "thresholds": [
            {
              "max_retries": 0
            }
          ]
        }
      }
    ]
  }
}
